# Strava API Credentials (for ActivExport)
# ⚠️ COPIER CE FICHIER EN .env ET REMPLIR VOS CREDENTIALS

# Vos credentials Strava (obtenus sur https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Les tokens seront ajoutés automatiquement après première authentification
# NE PAS REMPLIR MANUELLEMENT
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
STRAVA_TOKEN_EXPIRES_AT=

# Decathlon Coach API Credentials (for ActivExport --provider decathcoach)
# Obtenus après inscription sur https://forms.gle/4WKN7ihQBpyzMt389
DECATHLON_CLIENT_ID=
DECATHLON_CLIENT_SECRET=
DECATHLON_API_KEY=
